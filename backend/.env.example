# Publicat backend environment variables (all optional)

# The backend port and host
PORT=8001
HOST=0.0.0.0

# Add your LLM keys here via the Web UI (they will be saved in the database automatically).
# You do not need to populate them here unless explicitly required by a script.
S2_API_KEY=your_api_key_here

# Where the database lives (default: the per-user data directory, see README)
# PUBLICAT_DATA_DIR=/path/to/folder
# DATABASE_URL=sqlite:////absolute/path/publicat.db
# Bind address for the launcher (default 127.0.0.1; 0.0.0.0 to serve the LAN)
# PUBLICAT_HOST=127.0.0.1
# PUBLICAT_PORT=8001
# Skip the launch-time sync / model bootstrap (tests, smoke runs)
# PUBLICAT_FETCH_ON_START=1
# PUBLICAT_BOOTSTRAP=1
# Compute SPECTER2 embeddings locally (PyTorch) for papers Semantic Scholar has no vector for.
# Off by default: loading the model stalls the API and S2 covers nearly all papers.
# PUBLICAT_LOCAL_EMBEDDINGS=0
